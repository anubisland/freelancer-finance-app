rules_version = '2';

// Freelancer Finance App — Firestore security rules.
// Translates the security model from ARCHITECTURE.md §3 into deployable rules.
// Invariant: every read/write requires an authenticated session, and a user can
// only access documents under their own /users/{uid} subtree.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All sub-collections under a user (invoices, expenses, clients, reports)
      // and any nested documents inherit the same per-user isolation rule.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
