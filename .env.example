# Freelancer Finance App — Firebase client config (PUBLIC values only).
# Copy to `.env` and fill in with values from the Firebase Console:
#   Firebase Console → Project Settings → General → Your apps → SDK setup.
# `.env` is git-ignored. NEVER commit real values.
#
# Note: these values are considered public per Firebase guidance — security is
# enforced by Firestore/Storage rules + Firebase App Check, not by hiding them.
# Service account JSON keys (admin SDK) must be provisioned out-of-band and
# never written to this file or committed to the repo.

# ---- Firebase Web / React Native client SDK config ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---- Local emulator toggles (optional) ----
# Set to "true" when running `firebase emulators:start` so the client SDK
# points at the local emulators instead of the live project.
FIREBASE_USE_EMULATORS=false
FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
FIREBASE_STORAGE_EMULATOR_PORT=9199
FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
